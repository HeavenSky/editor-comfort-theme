{
	"name": "editor-comfort-theme",
	"version": "0.0.3",
	"keywords": [
		"theme",
		"one dark",
		"one light",
		"ayu",
		"solarized",
		"github",
		"dracula",
		"night owl",
		"monokai",
		"palenight",
		"eye care",
		"terminal"
	],
	"description": "%extension.description%",
	"displayName": "Editor Comfort Theme",
	"license": "MIT",
	"publisher": "HeavenSky",
	"bugs": {
		"url": "https://github.com/HeavenSky/editor-comfort-theme/issues"
	},
	"homepage": "https://github.com/HeavenSky/editor-comfort-theme",
	"repository": {
		"type": "git",
		"url": "https://github.com/HeavenSky/editor-comfort-theme.git"
	},
	"icon": "media/icon.png",
	"categories": [
		"Themes"
	],
	"contributes": {
		"themes": [
			{
				"label": "Comfort One Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/comfort-one-dark-color-theme.json"
			},
			{
				"label": "Comfort One Light",
				"uiTheme": "vs",
				"path": "./themes/comfort-one-light-color-theme.json"
			},
			{
				"label": "Comfort Ayu Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/comfort-ayu-dark-color-theme.json"
			},
			{
				"label": "Comfort Ayu Light",
				"uiTheme": "vs",
				"path": "./themes/comfort-ayu-light-color-theme.json"
			},
			{
				"label": "Comfort Sunlit Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/comfort-sunlit-dark-color-theme.json"
			},
			{
				"label": "Comfort Sunlit Light",
				"uiTheme": "vs",
				"path": "./themes/comfort-sunlit-light-color-theme.json"
			},
			{
				"label": "Comfort GitHub Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/comfort-github-dark-color-theme.json"
			},
			{
				"label": "Comfort GitHub Light",
				"uiTheme": "vs",
				"path": "./themes/comfort-github-light-color-theme.json"
			},
			{
				"label": "Comfort Dracula Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/comfort-dracula-dark-color-theme.json"
			},
			{
				"label": "Comfort Dracula Light",
				"uiTheme": "vs",
				"path": "./themes/comfort-dracula-light-color-theme.json"
			},
			{
				"label": "Comfort Owl Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/comfort-owl-dark-color-theme.json"
			},
			{
				"label": "Comfort Owl Light",
				"uiTheme": "vs",
				"path": "./themes/comfort-owl-light-color-theme.json"
			},
			{
				"label": "Comfort Moka Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/comfort-moka-dark-color-theme.json"
			},
			{
				"label": "Comfort Moka Light",
				"uiTheme": "vs",
				"path": "./themes/comfort-moka-light-color-theme.json"
			},
			{
				"label": "Comfort Pale Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/comfort-pale-dark-color-theme.json"
			},
			{
				"label": "Comfort Pale Light",
				"uiTheme": "vs",
				"path": "./themes/comfort-pale-light-color-theme.json"
			}
		]
	},
	"files": [
		"themes",
		"media/icon.png",
		"package.nls.json",
		"package.nls.zh-cn.json",
		"README.zh-cn.md",
		"LICENSE.txt",
		"NOTICE.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"compile": "node build.mjs",
		"build": "node build.mjs --production",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "node scripts/check.mjs",
		"check:template": "node scripts/check-template.mjs",
		"gen:icon": "node scripts/gen-icon.mjs",
		"extract:registry": "uv run tools/extract_registry.py",
		"gen:themes": "uv run tools/design.py && uv run tools/gen_vscode.py && uv run tools/gen_terminal.py",
		"metrics": "uv run tools/metrics.py --strict --check themes/*.json terminal/*.terminal",
		"similar": "uv run tools/similar.py themes/*.json",
		"clash": "uv run tools/clash.py && uv run tools/clash.py --markdown",
		"shots": "node tools/shoot.mjs media/screenshots --jpg",
		"package": "node scripts/package.mjs",
		"vscode:prepublish": "npm run build"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@vscode/vsce": "^4.0.0",
		"playwright-core": "^1.64.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.3.2",
		"vscode-types": "npm:@types/vscode@^1.140.0"
	},
	"engines": {
		"vscode": "^1.101.0"
	}
}
