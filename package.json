{
	"name": "editor-comfort-theme",
	"version": "0.0.4",
	"keywords": [
		"theme",
		"one dark",
		"one light",
		"ayu",
		"solarized",
		"github",
		"dracula",
		"night owl",
		"monokai",
		"palenight",
		"eye care",
		"terminal"
	],
	"description": "%extension.description%",
	"displayName": "Editor Comfort Theme",
	"license": "MIT",
	"publisher": "HeavenSky",
	"bugs": {
		"url": "https://github.com/HeavenSky/editor-comfort-theme/issues"
	},
	"homepage": "https://github.com/HeavenSky/editor-comfort-theme",
	"repository": {
		"type": "git",
		"url": "https://github.com/HeavenSky/editor-comfort-theme.git"
	},
	"icon": "media/icon.png",
	"categories": [
		"Themes"
	],
	"contributes": {
		"themes": [
			{
				"id": "C One Dark",
				"label": "C One Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/one-dark.json"
			},
			{
				"id": "C One Light",
				"label": "C One Light",
				"uiTheme": "vs",
				"path": "./themes/one-light.json"
			},
			{
				"id": "C Ayu Dark",
				"label": "C Ayu Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/ayu-dark.json"
			},
			{
				"id": "C Ayu Light",
				"label": "C Ayu Light",
				"uiTheme": "vs",
				"path": "./themes/ayu-light.json"
			},
			{
				"id": "C Sunlit Dark",
				"label": "C Sunlit Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/sunlit-dark.json"
			},
			{
				"id": "C Sunlit Light",
				"label": "C Sunlit Light",
				"uiTheme": "vs",
				"path": "./themes/sunlit-light.json"
			},
			{
				"id": "C GitHub Dark",
				"label": "C GitHub Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/github-dark.json"
			},
			{
				"id": "C GitHub Light",
				"label": "C GitHub Light",
				"uiTheme": "vs",
				"path": "./themes/github-light.json"
			},
			{
				"id": "C Dracula Dark",
				"label": "C Dracula Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/dracula-dark.json"
			},
			{
				"id": "C Dracula Light",
				"label": "C Dracula Light",
				"uiTheme": "vs",
				"path": "./themes/dracula-light.json"
			},
			{
				"id": "C Owl Dark",
				"label": "C Owl Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/owl-dark.json"
			},
			{
				"id": "C Owl Light",
				"label": "C Owl Light",
				"uiTheme": "vs",
				"path": "./themes/owl-light.json"
			},
			{
				"id": "C Moka Dark",
				"label": "C Moka Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/moka-dark.json"
			},
			{
				"id": "C Moka Light",
				"label": "C Moka Light",
				"uiTheme": "vs",
				"path": "./themes/moka-light.json"
			},
			{
				"id": "C Pale Dark",
				"label": "C Pale Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/pale-dark.json"
			},
			{
				"id": "C Pale Light",
				"label": "C Pale Light",
				"uiTheme": "vs",
				"path": "./themes/pale-light.json"
			}
		]
	},
	"files": [
		"themes",
		"media/icon.png",
		"package.nls.json",
		"package.nls.zh-cn.json",
		"README.zh-cn.md",
		"LICENSE.txt",
		"NOTICE.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"compile": "node build.mjs",
		"build": "node build.mjs --production",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "node scripts/check.mjs",
		"check:template": "node scripts/check-template.mjs",
		"gen:icon": "node scripts/gen-icon.mjs",
		"extract:registry": "uv run tools/extract_registry.py",
		"gen:themes": "uv run tools/design.py && uv run tools/complete.py && uv run tools/gen_vscode.py && uv run tools/gen_terminal.py",
		"pool:update": "uv run tools/pool.py --update && uv run tools/complete.py --guard",
		"metrics": "uv run tools/metrics.py themes/*.json terminal/*.terminal",
		"similar": "uv run tools/similar.py themes/*.json",
		"clash": "uv run tools/clash.py && uv run tools/clash.py --markdown",
		"shots": "node tools/shoot.mjs media/screenshots --jpg",
		"package": "node scripts/package.mjs",
		"vscode:prepublish": "npm run build"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@vscode/vsce": "^4.0.0",
		"playwright-core": "^1.64.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.3.2",
		"vscode-types": "npm:@types/vscode@^1.140.0"
	},
	"engines": {
		"vscode": "^1.101.0"
	}
}
