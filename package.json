{
	"name": "editor-comfort-theme",
	"version": "0.0.1",
	"keywords": [
		"theme",
		"one dark",
		"one light",
		"ayu",
		"solarized",
		"eye care",
		"terminal"
	],
	"description": "%extension.description%",
	"displayName": "Editor Comfort Theme",
	"license": "MIT",
	"publisher": "HeavenSky",
	"bugs": {
		"url": "https://github.com/HeavenSky/editor-comfort-theme/issues"
	},
	"homepage": "https://github.com/HeavenSky/editor-comfort-theme",
	"repository": {
		"type": "git",
		"url": "https://github.com/HeavenSky/editor-comfort-theme.git"
	},
	"icon": "media/icon.png",
	"categories": [
		"Themes"
	],
	"contributes": {
		"themes": [
			{
				"label": "One Dark Fit",
				"uiTheme": "vs-dark",
				"path": "./themes/one-dark-fit-color-theme.json"
			},
			{
				"label": "One Light Fit",
				"uiTheme": "vs",
				"path": "./themes/one-light-fit-color-theme.json"
			},
			{
				"label": "Comfort One Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/one-dark-color-theme.json"
			},
			{
				"label": "Comfort One Light",
				"uiTheme": "vs",
				"path": "./themes/one-light-color-theme.json"
			},
			{
				"label": "Comfort Ayu Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/ayu-dark-color-theme.json"
			},
			{
				"label": "Comfort Ayu Light",
				"uiTheme": "vs",
				"path": "./themes/ayu-light-color-theme.json"
			},
			{
				"label": "Comfort Solarized Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/solarized-dark-color-theme.json"
			},
			{
				"label": "Comfort Solarized Light",
				"uiTheme": "vs",
				"path": "./themes/solarized-light-color-theme.json"
			}
		]
	},
	"files": [
		"themes",
		"media/icon.png",
		"package.nls.json",
		"package.nls.zh-cn.json",
		"README.zh-cn.md",
		"LICENSE.txt",
		"NOTICE.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"compile": "node build.mjs",
		"build": "node build.mjs --production",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "node scripts/check.mjs",
		"check:template": "node scripts/check-template.mjs",
		"gen:icon": "node scripts/gen-icon.mjs",
		"extract:registry": "uv run tools/extract_registry.py",
		"gen:themes": "uv run tools/gen_vscode.py && uv run tools/gen_terminal.py",
		"metrics": "uv run tools/metrics.py --check themes/*.json terminal/*.terminal",
		"package": "node scripts/package.mjs",
		"vscode:prepublish": "npm run build"
	},
	"dependencies": {},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"@vscode/vsce": "^4.0.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"engines": {
		"vscode": "^1.101.0"
	}
}
