	"tokenColors": [
		{
			"name": "Comfort coverage: entity.name.type",
			"scope": "entity.name.type",
			"settings": {
				"foreground": "#DBB46D"
			}
		},
		{
			"name": "Comfort coverage: entity.name.namespace",
			"scope": "entity.name.namespace",
			"settings": {
				"foreground": "#A4BEC8"
			}
		},
		{
			"name": "Comfort coverage: meta.object-literal.key",
			"scope": "meta.object-literal.key",
			"settings": {
				"foreground": "#70C4E5"
			}
		},
		{
			"name": "Comfort coverage: markup.heading",
			"scope": "markup.heading",
			"settings": {
				"foreground": "#8CB2F0",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Global settings",
			"settings": {
				"foreground": "#B2BAC8"
			}
		},
		{
			"name": "Comment",
			"scope": "comment",
			"settings": {
				"foreground": "#8085A0",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String",
			"scope": "string",
			"settings": {
				"foreground": "#A6C37D"
			}
		},
		{
			"name": "String Quoted",
			"scope": "string.quoted",
			"settings": {
				"foreground": "#A6C37D"
			}
		},
		{
			"name": "String Unquoted",
			"scope": "string.unquoted",
			"settings": {
				"foreground": "#B2BAC8"
			}
		},
		{
			"name": "Support Constant Math",
			"scope": "support.constant.math",
			"settings": {
				"foreground": "#DBB46D"
			}
		},
		{
			"name": "Number",
			"scope": [
				"constant.numeric",
				"constant.character.numeric"
			],
			"settings": {
				"foreground": "#E59780"
			}
		},
		{
			"name": "Built-in constant",
			"scope": [
				"constant.language",
				"punctuation.definition.constant",
				"variable.other.constant"
			],
			"settings": {
				"foreground": "#8CABEC"
			}
		},
		{
			"name": "User-defined constant",
			"scope": [
				"constant.character",
				"constant.other"
			],
			"settings": {
				"foreground": "#8CABEC"
			}
		},
		{
			"name": "Constant Character Escape",
			"scope": "constant.character.escape",
			"settings": {
				"foreground": "#E59780"
			}
		},
		{
			"name": "RegExp String",
			"scope": [
				"string.regexp",
				"string.regexp keyword.other"
			],
			"settings": {
				"foreground": "#7CC6C0"
			}
		},
		{
			"name": "Comma in functions",
			"scope": "meta.function punctuation.separator.comma",
			"settings": {
				"foreground": "#ADBDBD"
			}
		},
		{
			"name": "Variable",
			"scope": "variable",
			"settings": {
				"foreground": "#DBB46D"
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"punctuation.accessor",
				"keyword"
			],
			"settings": {
				"foreground": "#C09ADA"
			}
		},
		{
			"name": "Storage",
			"scope": [
				"storage",
				"storage.type",
				"meta.var.expr storage.type",
				"storage.type.property.js",
