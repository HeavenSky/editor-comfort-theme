				"variable.annotation",
				"variable.function"
			],
			"settings": {
				"foreground": "#1F77B4"
			}
		},
		{
			"name": "Pool heading",
			"scope": [
				"beginning.punctuation.definition.list.markdown",
				"beginning.punctuation.definition.list.markdown.xi",
				"entity.name.section.toml",
				"header",
