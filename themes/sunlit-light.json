				"fontStyle": "bold"
			}
		},
		{
			"name": "Pool quote",
			"scope": [
				"beginning.punctuation.definition.quote.markdown",
				"beginning.punctuation.definition.quote.markdown.xi",
				"quote"
			],
			"settings": {
				"foreground": "#697900",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Pool text",
			"scope": [
				"block.scope.begin",
				"block.scope.end",
