	"tokenColors": [
		{
			"name": "Pool function",
			"scope": [
				"accent.xi",
				"meta.function-call.arguments.python",
				"meta.function-call.generic",
				"meta.function-call.generic.python",
				"meta.function-call.object",
				"meta.function-call.object.php",
				"meta.function-call.php",
				"meta.function-call.python",
				"meta.function-call.static",
				"meta.function-call.static.php",
				"ng.interpolation function.begin",
				"ng.interpolation function.end",
				"ng.interpolation.begin",
				"ng.interpolation.end",
				"source.go meta.function-call.go",
				"token.info-token"
			],
			"settings": {
				"foreground": "#DCBDFB"
			}
		},
		{
			"name": "Pool heading",
			"scope": [
				"beginning.punctuation.definition.list.markdown",
				"beginning.punctuation.definition.list.markdown.xi",
				"header",
				"markup.list punctuation.definition.list.begin",
				"punctuation.definition.string.begin.markdown",
				"punctuation.definition.string.end.markdown"
			],
			"settings": {
				"foreground": "#6CB6FF",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Pool quote",
			"scope": [
				"beginning.punctuation.definition.quote.markdown",
				"beginning.punctuation.definition.quote.markdown.xi",
				"quote"
			],
			"settings": {
				"foreground": "#8DDB8C",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Pool text",
			"scope": [
				"block.scope.begin",
				"block.scope.end",
				"function.brace",
				"function.parameter",
				"function.parameter.cs",
				"function.parameter.ruby",
				"markup.list",
				"markup.list.asciidoc",
				"terminator.js",
				"token.package",
				"token.variable.parameter.java"
			],
			"settings": {
				"foreground": "#ADBAC7"
