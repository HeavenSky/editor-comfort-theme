	"tokenColors": [
		{
			"name": "Comfort coverage: meta.object-literal.key",
			"scope": "meta.object-literal.key",
			"settings": {
				"foreground": "#3F4349"
			}
		},
		{
			"name": "Comfort coverage: markup.quote",
			"scope": "markup.quote",
			"settings": {
				"foreground": "#236131",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Comfort coverage: markup.underline.link",
			"scope": "markup.underline.link",
			"settings": {
				"foreground": "#204278"
			}
		},
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#69727C"
			}
		},
		{
			"scope": [
				"constant.other.placeholder",
				"constant.character"
			],
			"settings": {
				"foreground": "#994F4A"
			}
		},
		{
			"scope": [
				"constant",
				"entity.name.constant",
				"variable.other.constant",
				"variable.other.enummember",
				"variable.language",
				"entity"
			],
			"settings": {
				"foreground": "#30558C"
			}
		},
		{
			"scope": [
				"entity.name",
				"meta.export.default",
				"meta.definition.variable"
			],
			"settings": {
				"foreground": "#874427"
			}
		},
		{
			"scope": [
				"variable.parameter.function",
				"meta.jsx.children",
