	"tokenColors": [
		{
			"name": "Pool function",
			"scope": [
				"accent.xi",
				"entity.name.goto-label.php",
				"entity.name.variable.property.cs",
				"meta.function-call",
				"meta.function-call.arguments.python",
				"meta.function-call.generic",
				"meta.function-call.generic.python",
				"meta.function-call.python",
				"ng.interpolation function.begin",
				"ng.interpolation function.end",
				"ng.interpolation.begin",
				"ng.interpolation.end",
				"source.gfm link entity",
				"source.go meta.function-call.go",
				"token.info-token"
			],
			"settings": {
				"foreground": "#14710A"
			}
		},
		{
			"name": "Pool text",
			"scope": [
				"block.scope.begin",
				"block.scope.end",
				"function.brace",
				"function.parameter",
				"function.parameter.cs",
				"function.parameter.ruby",
				"markup.list",
				"markup.list.asciidoc",
				"terminator.js",
				"token.package",
				"token.variable.parameter.java"
			],
			"settings": {
				"foreground": "#1F1F1F"
			}
		},
		{
			"name": "Pool builtin_type",
			"scope": [
				"bold",
				"markup.table",
				"source.css property-name"
			],
			"settings": {
				"foreground": "#036A96"
			}
		},
		{
			"name": "Pool comment",
			"scope": [
				"brackethighlighter.angle",
				"brackethighlighter.curly",
				"brackethighlighter.quote",
				"brackethighlighter.round",
				"brackethighlighter.square",
				"brackethighlighter.tag",
				"comment markup.link",
				"markup.ignored",
				"markup.untracked"
			],
			"settings": {
				"foreground": "#6C664B"
			}
		},
		{
			"name": "Pool deleted",
			"scope": [
				"brackethighlighter.unmatched"
			],
			"settings": {
				"foreground": "#CB3A2A"
			}
		},
		{
			"name": "Pool string",
			"scope": [
				"carriage-return",
				"entity.name.import",
				"entity.name.package",
				"meta.link.inline.markdown punctuation.definition.string",
				"meta.template.expression.js string.template punctuation.definition.string.template",
				"meta.template.expression.jsx string.template punctuation.definition.string.template",
				"meta.template.expression.ts string.template punctuation.definition.string.template",
				"meta.template.expression.tsx string.template punctuation.definition.string.template",
				"punctuation.definition.string.markdown",
				"source.elixir punctuation.definition.string",
				"source.elixir quoted",
				"string.quoted.double.json punctuation.definition.string.json",
				"string.unquoted.heredoc punctuation.definition.string"
			],
			"settings": {
				"foreground": "#846E15"
			}
		},
		{
