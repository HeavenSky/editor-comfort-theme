			"settings": {
				"foreground": "#86BF85",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Comfort coverage: markup.underline.link",
			"scope": "markup.underline.link",
			"settings": {
				"foreground": "#7EB7E5"
			}
		},
		{
			"scope": [
				"comment",
