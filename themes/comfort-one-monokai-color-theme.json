	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#7D8594"
			}
		},
		{
			"name": "String",
			"scope": [
				"string",
				"string.template"
			],
			"settings": {
				"foreground": "#D7B26D"
			}
		},
		{
			"name": "Number",
